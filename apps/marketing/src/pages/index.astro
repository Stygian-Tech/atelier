---
import SiteLayout from "../layouts/SiteLayout.astro";

const origins = {
  home: import.meta.env.ATELIER_HOME_ORIGIN ?? "http://localhost:3000",
  notes: import.meta.env.ATELIER_NOTES_ORIGIN ?? "http://localhost:3001",
  mail: import.meta.env.ATELIER_MAIL_ORIGIN ?? "http://localhost:3002",
  calendar: import.meta.env.ATELIER_CALENDAR_ORIGIN ?? "http://localhost:3003",
  tasks: import.meta.env.ATELIER_TASKS_ORIGIN ?? "http://localhost:3004",
  docs: import.meta.env.ATELIER_DOCS_ORIGIN ?? "http://localhost:4322",
  status: import.meta.env.ATELIER_STATUS_ORIGIN ?? "http://localhost:4323",
};

const products = [
  { name: "Atelier", tag: "Your day, composed", description: "Today, Inbox, Projects, search, and deliberate cross-app actions in one calm workspace.", color: "coral", href: origins.home },
  { name: "Notes", tag: "Markdown without lock-in", description: "Real local .md files, backlinks, versions, and shared editing over Automerge and Iroh.", color: "cyan", href: origins.notes },
  { name: "Mail", tag: "Your inbox, not the provider's", description: "Gmail-first daily-driver mail with provider-neutral models and Markdown composition.", color: "butter", href: origins.mail },
  { name: "Calendar", tag: "Open schedules, faithfully kept", description: "Lossless ICS, provider sync, feeds, and compatible community calendar projections.", color: "coral", href: origins.calendar },
  { name: "Tasks", tag: "Shared work that stays yours", description: "Projects, dependencies, recurrence, offline edits, and owner-canonical collaboration.", color: "cyan", href: origins.tasks },
];

const questions = [
  ["Is my Atelier content private?", "Not during the standard-PDS phase. First-party Notes, Tasks, Calendar, Projects, Captures, and relationships are readable public records. Atelier discloses this before every affected write. Provider mail and calendar content remains protected server-side."],
  ["Can I leave?", "Yes. Notes remain Markdown, calendars round-trip through ICS, and ATProto records stay in your repository. Exports do not require a proprietary reader."],
  ["Where does collaboration happen?", "Notes use a shared Rust Automerge-over-Iroh protocol with a trusted Railway anchor and opportunistic direct peers. Other products use scoped owner-mediated XRPC writes."],
  ["What is available first?", "The coordinated public beta opens only when Home, Notes, Mail, Calendar, and Tasks all clear their product, accessibility, security, and provider gates."],
];
---

<SiteLayout
  title="Atelier — Your work, in your hands"
  description="An open, native productivity suite for notes, mail, calendars, and tasks, powered by ATProto."
>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Atelier home"><span aria-hidden="true">A</span> Atelier</a>
    <nav aria-label="Primary navigation">
      <a href="#products">Products</a>
      <a href="#principles">Principles</a>
      <a href="#developers">Developers</a>
      <a href={origins.docs}>Docs</a>
    </nav>
    <a class="beta-button" href="#beta">Join the beta <span aria-hidden="true">↗</span></a>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="kicker">A workspace built on open protocols</p>
        <h1>Your work,<br /><em>in your hands.</em></h1>
        <p class="hero-lede">Atelier brings notes, mail, calendars, and tasks into one thoughtful suite—native on every device, portable by design, and powered by your ATProto identity.</p>
        <div class="hero-actions">
          <a class="primary-button" href="#beta">Join the open beta <span aria-hidden="true">→</span></a>
          <a class="text-link" href="#principles">Why open protocols?</a>
        </div>
        <ul class="platforms" aria-label="Supported platforms">
          <li>Web</li><li>iPhone & iPad</li><li>macOS</li><li>Android</li>
        </ul>
      </div>
      <div class="hero-art" aria-label="A layered preview of Atelier Notes, Mail, Calendar, and Tasks">
        <div class="paper-card note-preview">
          <div class="mini-chrome"><i></i><i></i><i></i><span>Project Atlas.md</span></div>
          <p class="mini-kicker">ATELIER NOTES</p>
          <h2>Ideas need<br />room to breathe.</h2>
          <p>Markdown-first writing with shared editing that follows you from desktop to pocket.</p>
          <div class="scribble">Turn raw thoughts into connected work.</div>
          <div class="presence"><b>SC</b><b>JD</b><span>2 people editing</span></div>
        </div>
        <div class="paper-card mail-preview">
          <div class="mini-chrome"><i></i><i></i><i></i><span>Unified Inbox</span></div>
          <div class="mail-shell">
            <div class="mail-sidebar"><b>Inbox</b><span>Starred</span><span>Drafts</span><span>Sent</span></div>
            <div class="mail-list"><article><b>Project Atlas review</b><span>Could we move the launch date…</span></article><article><b>Design system notes</b><span>The coral tokens are ready.</span></article><article><b>Gmail verification</b><span>Security review checklist</span></article></div>
          </div>
        </div>
        <div class="paper-card calendar-preview">
          <strong>Calendar</strong><div class="week-line"><span>MON</span><span>TUE</span><span>WED</span><span>THU</span></div><div class="calendar-event">Design sync · 10:00</div>
        </div>
        <div class="paper-card task-preview">
          <strong>Today</strong><label><input type="checkbox" checked /> Choose public NSIDs</label><label><input type="checkbox" /> Polish Notes editor</label>
        </div>
      </div>
    </section>

    <section class="principle-strip" aria-label="Atelier principles">
      <span>Portable by default</span><span>Native everywhere</span><span>Built for collaboration</span><span>No dark patterns</span>
    </section>

    <section class="section products" id="products">
      <div class="section-intro">
        <p class="kicker">Five focused tools, one shared foundation</p>
        <h2>Everything you need.<br /><em>Nothing you don’t.</em></h2>
        <p>Each product stands on its own. Together, typed relationships turn a message into a task or an event into a note without inventing a second copy of your data.</p>
      </div>
      <div class="product-grid">
        {products.map((product, index) => (
          <a class={`product-card tone-${product.color} product-${index + 1}`} href={product.href}>
            <span class="product-number">0{index + 1}</span>
            <span class="product-icon" aria-hidden="true">{["A", "¶", "✉", "▦", "✓"][index]}</span>
            <h3>Atelier {product.name === "Atelier" ? "" : product.name}</h3>
            <strong>{product.tag}</strong>
            <p>{product.description}</p>
            <span class="learn-link">Explore {product.name} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="section public-data" id="principles">
      <div class="public-copy">
        <p class="kicker">Honest about the protocol</p>
        <h2>Your PDS records are public.<br /><em>We say so before you write.</em></h2>
        <p>Standard ATProto repositories are readable. During Atelier’s interim model, first-party work records use that public substrate with explicit disclosure and user-scoped discovery. Provider credentials, Gmail content, and private calendar mirrors never go there by default.</p>
        <a class="text-link" href={`${origins.docs}/concepts/public-data/`}>Read the public-data model <span aria-hidden="true">→</span></a>
      </div>
      <div class="record-card">
        <div class="record-head"><span class="public-pill">PUBLIC PDS</span><span>diy.atelier.notes.note</span></div>
        <pre><code>{`{
  "title": "Project Atlas brief",
  "markdown": { "$type": "at.markpub.markdown" },
  "checkpoint": { "uri": "at://did:plc:…/…", "cid": "bafy…" },
  "schemaVersion": 1,
  "createdAt": "2026-08-30T20:00:00Z",
  "updatedAt": "2026-08-30T20:00:00Z"
}`}</code></pre>
        <div class="record-warning"><b>Readable by anyone who finds the record</b><span>Permissioned Spaces migration is capability-gated and opt-in during alpha.</span></div>
      </div>
    </section>

    <section class="section collaboration" id="developers">
      <div class="collab-intro">
        <p class="kicker">Collaboration without surrender</p>
        <h2>Local-first writing.<br /><em>Peer-aware sync.</em></h2>
        <p>Your Markdown file is the source. Automerge tracks collaborative intent; Iroh carries it between authenticated devices and the trusted sync anchor.</p>
      </div>
      <div class="protocol-flow" aria-label="Atelier Notes collaboration protocol flow">
        <article><span>01</span><b>Markdown</b><p>Portable source on your device</p></article>
        <i aria-hidden="true">→</i>
        <article><span>02</span><b>Automerge</b><p>Convergent edits and versions</p></article>
        <i aria-hidden="true">→</i>
        <article><span>03</span><b>Iroh</b><p>Authenticated peer transport</p></article>
        <i aria-hidden="true">→</i>
        <article><span>04</span><b>Sync anchor</b><p>Reliable rendezvous and durability</p></article>
      </div>
      <div class="developer-links">
        <a href={`${origins.docs}/developers/protocol/`}>Protocol documentation <span aria-hidden="true">→</span></a>
        <a href="https://github.com/Stygian-Tech/atelier">MIT source on GitHub <span aria-hidden="true">→</span></a>
        <a href={`${origins.docs}/developers/mcp/`}>MCP tool approvals <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="section everywhere">
      <div>
        <p class="kicker">One workspace, every screen</p>
        <h2>Native where it matters.<br /><em>Web when it helps.</em></h2>
        <p>Five universal SwiftUI apps, five Compose apps, and five focused web experiences share contracts without forcing every platform into the same interaction model.</p>
      </div>
      <div class="device-stage" aria-label="Atelier across desktop, tablet, and phone">
        <div class="desktop-device"><div class="device-bar"></div><div class="device-ui"><aside>Today<br />Inbox<br />Projects</aside><main><b>Good morning.</b><span></span><span></span><span></span></main></div></div>
        <div class="tablet-device"><div class="device-ui"><aside>Notes<br />Shared</aside><main><b>Project Atlas</b><span></span><span></span></main></div></div>
        <div class="phone-device"><div class="phone-notch"></div><b>Today</b><span></span><span></span><span></span></div>
      </div>
    </section>

    <section class="section open-formats">
      <p class="kicker">Your exit is a feature</p>
      <h2>Open formats, all the way down.</h2>
      <div class="format-grid">
        <article><b>.md</b><h3>Markdown</h3><p>Notes and rich bodies stay readable in ordinary tools.</p></article>
        <article><b>.ics</b><h3>Calendar</h3><p>Round-trip schedules without discarding RFC 5545 detail.</p></article>
        <article><b>at://</b><h3>ATProto</h3><p>Identity, records, relationships, and public publishing.</p></article>
        <article><b>MCP</b><h3>Agent access</h3><p>Authenticated tools with approvals for sensitive actions.</p></article>
      </div>
    </section>

    <section class="section faq">
      <div><p class="kicker">Questions, answered plainly</p><h2>Before you join.</h2></div>
      <div class="questions">
        {questions.map(([question, answer]) => (
          <details>
            <summary>{question}<span aria-hidden="true">+</span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="beta-cta" id="beta">
      <div>
        <p class="kicker">A coordinated public beta</p>
        <h2>Make space for<br /><em>your best work.</em></h2>
        <p>Join the list for the open beta. We will only invite people when all five products clear the same accessibility, security, and reliability gates.</p>
      </div>
      <form aria-describedby="beta-capture-status" data-beta-preview>
        <label for="email">Email signup preview</label>
        <div><input id="email" type="email" placeholder="Signup opens after approval" disabled /><button type="button" disabled>Coming later <span aria-hidden="true">→</span></button></div>
        <small id="beta-capture-status">Address collection is disabled until the consent-aware Postmark workflow is approved.</small>
      </form>
    </section>
  </main>

  <footer>
    <a class="wordmark" href="#top"><span aria-hidden="true">A</span> Atelier</a>
    <p>Open tools for thoughtful work.<br />Built by Stygian Tech.</p>
    <nav aria-label="Footer navigation"><a href={origins.docs}>Docs</a><a href={origins.status}>Status</a><a href={`${origins.docs}/legal/privacy/`}>Privacy</a><a href={`${origins.docs}/support/`}>Support</a><a href="https://github.com/Stygian-Tech/atelier">GitHub</a></nav>
    <small>© 2026 Stygian Tech · MIT licensed</small>
  </footer>
</SiteLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  .site-header { position: sticky; z-index: 50; top: 0; display: grid; grid-template-columns: 1fr auto 1fr; min-height: 4.7rem; align-items: center; padding: 0.75rem clamp(1rem, 5vw, 5.5rem); border-bottom: 1px solid color-mix(in srgb, var(--atelier-border) 80%, transparent); background: color-mix(in srgb, var(--atelier-paper) 90%, transparent); backdrop-filter: blur(18px); }
  .wordmark { display: inline-flex; align-items: center; gap: 0.65rem; width: fit-content; font-family: ui-serif, Georgia, serif; font-size: 1.24rem; font-weight: 700; text-decoration: none; }
  .wordmark span { display: grid; width: 2.2rem; height: 2.2rem; place-items: center; border-radius: 0.72rem; background: var(--atelier-coral); color: white; font-size: 1.45rem; font-style: italic; }
  .site-header nav, footer nav { display: flex; align-items: center; gap: 1.5rem; }
  .site-header nav a, footer nav a { color: var(--atelier-muted); font-size: 0.78rem; font-weight: 760; text-decoration: none; }
  .site-header nav a:hover, footer nav a:hover { color: var(--atelier-coral); }
  .beta-button { justify-self: end; padding: 0.65rem 0.9rem; border-radius: 0.7rem; background: var(--atelier-ink); color: var(--atelier-paper); font-size: 0.76rem; font-weight: 850; text-decoration: none; }
  .hero { display: grid; min-height: calc(100dvh - 4.7rem); grid-template-columns: minmax(18rem, 0.87fr) minmax(28rem, 1.13fr); align-items: center; gap: clamp(2rem, 6vw, 7rem); padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 7vw, 7.5rem); overflow: hidden; }
  .kicker { margin: 0 0 0.9rem; color: var(--atelier-coral); font-size: 0.7rem; font-weight: 900; letter-spacing: 0.13em; text-transform: uppercase; }
  .hero h1, .section h2, .beta-cta h2 { margin: 0; font-family: ui-serif, Georgia, serif; font-size: clamp(3.6rem, 7.4vw, 7.2rem); font-weight: 450; letter-spacing: -0.06em; line-height: 0.85; }
  .hero h1 em, .section h2 em, .beta-cta h2 em { color: var(--atelier-coral); font-weight: 450; }
  .hero-lede { max-width: 38rem; margin: 2rem 0 0; color: var(--atelier-muted); font-size: clamp(1rem, 1.6vw, 1.22rem); line-height: 1.7; }
  .hero-actions { display: flex; align-items: center; gap: 1.3rem; margin-top: 2rem; }
  .primary-button { display: inline-flex; align-items: center; gap: 1rem; padding: 0.9rem 1.1rem; border-radius: 0.75rem; background: var(--atelier-coral); color: white; font-size: 0.83rem; font-weight: 900; text-decoration: none; box-shadow: 0 10px 30px rgb(255 101 66 / 0.22); }
  .text-link { color: var(--atelier-ink); font-size: 0.8rem; font-weight: 850; text-underline-offset: 0.25rem; }
  .platforms { display: flex; flex-wrap: wrap; gap: 1rem; margin: 2.3rem 0 0; padding: 0; color: var(--atelier-muted); font-size: 0.68rem; font-weight: 800; list-style: none; }
  .platforms li::before { margin-right: 0.35rem; color: var(--atelier-cyan); content: "●"; }
  .hero-art { position: relative; min-height: 35rem; perspective: 1200px; }
  .paper-card { position: absolute; overflow: hidden; border: 1px solid var(--atelier-border); border-radius: 1rem; background: var(--atelier-paper-raised); box-shadow: 0 24px 80px rgb(73 44 34 / 0.18); }
  .mini-chrome { display: flex; height: 2.05rem; align-items: center; gap: 0.32rem; padding: 0 0.75rem; border-bottom: 1px solid var(--atelier-border); background: var(--atelier-paper-soft); }
  .mini-chrome i { width: 0.42rem; height: 0.42rem; border-radius: 50%; background: var(--atelier-border); }
  .mini-chrome i:first-child { background: var(--atelier-coral); }
  .mini-chrome i:nth-child(2) { background: var(--atelier-butter); }
  .mini-chrome i:nth-child(3) { background: var(--atelier-cyan); }
  .mini-chrome span { margin-left: auto; color: var(--atelier-muted); font-size: 0.58rem; }
  .note-preview { z-index: 2; top: 1rem; left: 1rem; width: min(32rem, 82%); min-height: 26rem; padding-bottom: 1.6rem; transform: rotate(-3deg); }
  .note-preview > :not(.mini-chrome) { margin-right: 2rem; margin-left: 2rem; }
  .mini-kicker { margin-top: 2rem; color: var(--atelier-cyan); font-size: 0.55rem; font-weight: 900; letter-spacing: 0.12em; }
  .note-preview h2 { margin-top: 0.6rem; font-family: ui-serif, Georgia, serif; font-size: clamp(2rem, 4vw, 3.35rem); font-weight: 500; letter-spacing: -0.05em; line-height: 0.94; }
  .note-preview p:not(.mini-kicker) { max-width: 23rem; color: var(--atelier-muted); font-size: 0.75rem; line-height: 1.6; }
  .scribble { padding: 0.65rem 0; border-top: 1px dashed var(--atelier-border); border-bottom: 1px dashed var(--atelier-border); color: var(--atelier-coral); font-family: ui-serif, Georgia, serif; font-size: 0.9rem; font-style: italic; }
  .presence { display: flex; align-items: center; margin-top: 1.4rem !important; }
  .presence b { display: grid; width: 1.6rem; height: 1.6rem; place-items: center; margin-right: -0.25rem; border: 2px solid white; border-radius: 50%; background: var(--atelier-cyan); color: white; font-size: 0.48rem; }
  .presence b:nth-child(2) { background: var(--atelier-coral); }
  .presence span { margin-left: 0.7rem; color: var(--atelier-muted); font-size: 0.58rem; }
  .mail-preview { z-index: 3; right: -1rem; bottom: 2rem; width: min(32rem, 82%); min-height: 21rem; transform: rotate(3deg); }
  .mail-shell { display: grid; min-height: 18.9rem; grid-template-columns: 7.6rem 1fr; }
  .mail-sidebar { display: flex; flex-direction: column; gap: 0.8rem; padding: 1.1rem 0.8rem; border-right: 1px solid var(--atelier-border); background: var(--atelier-paper-soft); color: var(--atelier-muted); font-size: 0.65rem; }
  .mail-sidebar b { padding: 0.42rem; border-radius: 0.45rem; background: var(--atelier-coral-soft); color: var(--atelier-ink); }
  .mail-list article { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.05rem; border-bottom: 1px solid var(--atelier-border); font-size: 0.69rem; }
  .mail-list article span { color: var(--atelier-muted); font-size: 0.58rem; }
  .calendar-preview { z-index: 1; right: 0; top: 2rem; width: 18rem; height: 12rem; padding: 1.1rem; transform: rotate(7deg); }
  .week-line { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 1rem; color: var(--atelier-muted); font-size: 0.48rem; }
  .calendar-event { width: 55%; margin: 1rem 0 0 25%; padding: 0.65rem; border-radius: 0.5rem; background: var(--atelier-cyan-soft); color: #17434a; font-size: 0.58rem; font-weight: 800; }
  .task-preview { z-index: 4; left: -1rem; bottom: 0; display: flex; width: 16rem; min-height: 10rem; flex-direction: column; gap: 0.8rem; padding: 1.1rem; transform: rotate(-7deg); }
  .task-preview label { font-size: 0.62rem; }
  .task-preview input { accent-color: var(--atelier-coral); }
  .principle-strip { display: grid; grid-template-columns: repeat(4, 1fr); padding: 1.25rem clamp(1rem, 7vw, 7.5rem); border-top: 1px solid var(--atelier-border); border-bottom: 1px solid var(--atelier-border); background: var(--atelier-paper-raised); color: var(--atelier-muted); font-size: 0.67rem; font-weight: 850; letter-spacing: 0.04em; text-align: center; text-transform: uppercase; }
  .principle-strip span:not(:last-child) { border-right: 1px solid var(--atelier-border); }
  .section { padding: clamp(5rem, 9vw, 9rem) clamp(1rem, 7vw, 7.5rem); }
  .section h2 { max-width: 58rem; font-size: clamp(3rem, 6.2vw, 6rem); }
  .section-intro { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: 2rem; align-items: end; }
  .section-intro .kicker, .section-intro h2 { grid-column: 1; }
  .section-intro > p:last-child { grid-row: 1 / span 2; grid-column: 2; align-self: end; color: var(--atelier-muted); line-height: 1.7; }
  .product-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; margin-top: 4rem; }
  .product-card { position: relative; min-height: 22rem; padding: 1.4rem; overflow: hidden; border: 1px solid var(--atelier-border); border-radius: 1.25rem; background: var(--atelier-paper-raised); color: var(--atelier-ink); text-decoration: none; transition: transform 180ms ease, box-shadow 180ms ease; }
  .product-card:hover { transform: translateY(-0.35rem); box-shadow: var(--atelier-shadow); }
  .product-1, .product-2, .product-3 { grid-column: span 2; }
  .product-4, .product-5 { grid-column: span 3; }
  .product-number { color: var(--atelier-muted); font-size: 0.58rem; font-weight: 850; }
  .product-icon { display: grid; width: 3.6rem; height: 3.6rem; place-items: center; margin: 2.3rem 0 1.1rem; border-radius: 1rem; background: var(--tone); color: var(--tone-ink, white); font-family: ui-serif, Georgia, serif; font-size: 1.6rem; font-weight: 800; }
  .tone-coral { --tone: var(--atelier-coral); }
  .tone-cyan { --tone: var(--atelier-cyan); }
  .tone-butter { --tone: var(--atelier-butter); --tone-ink: #2e2608; }
  .product-card h3 { margin: 0; font-family: ui-serif, Georgia, serif; font-size: 1.45rem; }
  .product-card strong { display: block; margin-top: 0.45rem; font-size: 0.76rem; }
  .product-card p { color: var(--atelier-muted); font-size: 0.75rem; line-height: 1.55; }
  .learn-link { position: absolute; right: 1.4rem; bottom: 1.3rem; left: 1.4rem; color: color-mix(in srgb, var(--tone) 82%, var(--atelier-ink)); font-size: 0.7rem; font-weight: 900; }
  .public-data { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(2rem, 7vw, 7rem); align-items: center; background: var(--atelier-ink); color: var(--atelier-paper); }
  .public-data p:not(.kicker) { max-width: 42rem; color: color-mix(in srgb, var(--atelier-paper) 64%, transparent); line-height: 1.75; }
  .public-data .text-link { color: var(--atelier-paper); }
  .public-data h2 { font-size: clamp(2.8rem, 5.2vw, 5rem); }
  .record-card { overflow: hidden; border: 1px solid #4a4542; border-radius: 1rem; background: #151311; box-shadow: 0 30px 80px rgb(0 0 0 / 0.4); }
  .record-head { display: flex; align-items: center; justify-content: space-between; padding: 0.85rem 1rem; border-bottom: 1px solid #37322f; color: #a9a19c; font-family: ui-monospace, monospace; font-size: 0.62rem; }
  .public-pill { padding: 0.25rem 0.45rem; border-radius: 999px; background: #472016; color: #ff9b83; font-family: ui-sans-serif, sans-serif; font-size: 0.52rem; font-weight: 900; }
  .record-card pre { margin: 0; padding: 2rem; overflow-x: auto; color: #d9fbff; font-size: clamp(0.65rem, 1.1vw, 0.84rem); line-height: 1.8; }

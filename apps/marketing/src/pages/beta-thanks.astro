---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Beta signup is not open — Atelier"
  description="Atelier is a foundation preview; beta signup and address collection are not open."
  indexable={false}
  structuredData={false}
>
  <main class="thanks">
    <a class="atelier-brand" href="/"><span class="atelier-brand-mark">A</span> Atelier</a>
    <p class="atelier-eyebrow">Foundation preview</p>
    <h1>Beta signup is not open.</h1>
    <p>No interest was submitted and no address was collected. This route exists only to make the current release boundary explicit.</p>
    <a class="atelier-button" href="/">Back to Atelier</a>
  </main>
</SiteLayout>

<style>
  .thanks { display: grid; width: min(42rem, calc(100% - 2rem)); min-height: 100dvh; align-content: center; justify-items: start; margin: 0 auto; }
  h1 { margin: 0 0 1rem; font-family: ui-serif, Georgia, serif; font-size: clamp(3rem, 9vw, 6rem); font-weight: 500; letter-spacing: -0.06em; line-height: 0.9; }
  p:not(.atelier-eyebrow) { max-width: 36rem; color: var(--atelier-muted); line-height: 1.7; }
</style>

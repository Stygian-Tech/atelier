FROM oven/bun:1.3.14-alpine AS builder
WORKDIR /app
ARG ATELIER_ENV=deployment-unconfigured
ARG ATELIER_MARKETING_ORIGIN
ARG ATELIER_HOME_ORIGIN
ARG ATELIER_NOTES_ORIGIN
ARG ATELIER_MAIL_ORIGIN
ARG ATELIER_CALENDAR_ORIGIN
ARG ATELIER_TASKS_ORIGIN
ARG ATELIER_DOCS_ORIGIN
ARG ATELIER_STATUS_ORIGIN
ENV ATELIER_ENV=$ATELIER_ENV
ENV ATELIER_MARKETING_ORIGIN=$ATELIER_MARKETING_ORIGIN
ENV ATELIER_HOME_ORIGIN=$ATELIER_HOME_ORIGIN
ENV ATELIER_NOTES_ORIGIN=$ATELIER_NOTES_ORIGIN
ENV ATELIER_MAIL_ORIGIN=$ATELIER_MAIL_ORIGIN
ENV ATELIER_CALENDAR_ORIGIN=$ATELIER_CALENDAR_ORIGIN
ENV ATELIER_TASKS_ORIGIN=$ATELIER_TASKS_ORIGIN
ENV ATELIER_DOCS_ORIGIN=$ATELIER_DOCS_ORIGIN
ENV ATELIER_STATUS_ORIGIN=$ATELIER_STATUS_ORIGIN
COPY . .
RUN bun install --frozen-lockfile
RUN bunx turbo run build --filter=@stygian/atelier-marketing
RUN bun run infra/web/release-artifacts.ts --root apps/marketing/dist

FROM oven/bun:1.3.14-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4321
ENV STATIC_ROOT=/app/dist
COPY --from=builder /app/apps/marketing/dist /app/dist
COPY infra/static-server/server.ts /app/server.ts
EXPOSE 4321
CMD ["bun", "run", "/app/server.ts"]

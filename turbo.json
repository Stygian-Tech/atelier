{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ATELIER_ENV",
        "ATELIER_PUBLIC_ORIGIN",
        "ATELIER_API_ORIGIN",
        "ATELIER_MCP_ORIGIN",
        "ATELIER_MARKETING_ORIGIN",
        "ATELIER_DOCS_ORIGIN",
        "ATELIER_STATUS_ORIGIN",
        "ATELIER_HOME_ORIGIN",
        "ATELIER_NOTES_ORIGIN",
        "ATELIER_MAIL_ORIGIN",
        "ATELIER_CALENDAR_ORIGIN",
        "ATELIER_TASKS_ORIGIN",
        "NEXT_PUBLIC_APP_ENV",
        "NEXT_PUBLIC_HOME_URL",
        "NEXT_PUBLIC_NOTES_URL",
        "NEXT_PUBLIC_MAIL_URL",
        "NEXT_PUBLIC_CALENDAR_URL",
        "NEXT_PUBLIC_TASKS_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@stygian/atelier-design-system#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@stygian/atelier-web-ui#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}

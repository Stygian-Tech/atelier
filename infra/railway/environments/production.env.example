# Production is intentionally inert. Populate references and approve the final
# deployment/DNS transaction before changing any activation gate.
ATELIER_ENV=production
ATELIER_PUBLIC_ORIGIN=https://atelier.diy
ATELIER_API_ORIGIN=https://api.atelier.diy
ATELIER_MCP_ORIGIN=https://mcp.atelier.diy

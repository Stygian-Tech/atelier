{
  "lexicon": 1,
  "id": "diy.atelier.project.project",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A shared cross-product Atelier project. Publicly readable in a standard AT Protocol repository.",
      "record": {
        "type": "object",
        "required": ["name", "status", "createdAt", "updatedAt", "schemaVersion"],
        "properties": {
          "name": { "type": "string", "maxLength": 512 },
          "description": { "type": "ref", "ref": "at.markpub.markdown" },
          "status": { "type": "string", "knownValues": ["active", "archived"] },
          "memberDids": { "type": "array", "maxLength": 128, "items": { "type": "string", "format": "did" } },
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}

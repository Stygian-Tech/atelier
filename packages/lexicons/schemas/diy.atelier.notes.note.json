{
  "lexicon": 1,
  "id": "diy.atelier.notes.note",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A user-owned Atelier note. Standard AT Protocol repositories are publicly readable; clients must disclose that before writing this record.",
      "record": {
        "type": "object",
        "required": ["title", "markdown", "createdAt", "updatedAt", "schemaVersion"],
        "properties": {
          "title": { "type": "string", "maxLength": 512 },
          "markdown": { "type": "ref", "ref": "at.markpub.markdown" },
          "summary": { "type": "string", "maxLength": 2000 },
          "project": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "tags": { "type": "array", "maxLength": 64, "items": { "type": "string", "maxLength": 128 } },
          "attachmentBlobs": { "type": "array", "maxLength": 64, "items": { "type": "blob", "accept": ["*/*"], "maxSize": 52428800 } },
          "checkpoint": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}

{
  "name": "atelier",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/web/*",
    "apps/marketing",
    "apps/docs",
    "apps/status",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run typecheck lint test build",
    "verify:rust": "cargo test --manifest-path packages/rust/Cargo.toml --workspace --all-targets",
    "verify:swift": "env DEVELOPER_DIR=/Applications/Xcode-beta.app/Contents/Developer swift test --package-path packages/swift"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
